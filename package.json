{
  "name": "fhdod-experiencia-paciente",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do FHDOD — Sistema de Gestão da Experiência do Paciente (Express 5 + TypeScript + MySQL 8.4; projeto acadêmico ETE Monteiro Lobato – CIMOL)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:no-watch": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unidade-e-integracao --project banco",
    "test:watch": "vitest --project unidade-e-integracao --project banco",
    "test:coverage": "vitest run --project unidade-e-integracao --project banco --coverage",
    "test:db": "vitest run --project banco",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:schema:check && npm run test && npm run build",
    "db:create": "tsx scripts/db/migrate.ts create",
    "db:migrate": "tsx scripts/db/migrate.ts up",
    "db:migrate:status": "tsx scripts/db/migrate.ts status",
    "db:migration:new": "tsx scripts/db/migrate.ts new",
    "db:schema": "tsx scripts/db/migrate.ts schema",
    "db:schema:check": "tsx scripts/db/migrate.ts schema:check",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:seed:export": "tsx scripts/db/seed.ts --sql database/seeds/gerado/002_demonstracao.sql",
    "db:seed:verify": "tsx scripts/db/verify-seed.ts",
    "db:reset": "tsx scripts/db/reset-local.ts",
    "db:create-admin": "tsx scripts/db/create-admin.ts",
    "e2e:fixture": "tsx scripts/e2e/fixture.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
