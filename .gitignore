# ------------------------------------------------------------------
# Dependências
# ------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/

# ------------------------------------------------------------------
# Builds e arquivos gerados
# ------------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo
.vite/
frontend/vite.config.*.timestamp-*
.cache/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------
# Testes e cobertura
# ------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
junit*.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------
# Variáveis de ambiente e segredos
# Somente os arquivos *.env.example (valores fictícios) são versionados.
# ------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
secrets/

# Supabase CLI (estado local; config.toml será versionado na ET02)
supabase/.branches/
supabase/.temp/
supabase/.env

# Backups do banco gerados localmente (npm run db:backup, etapas futuras)
backups/
*.dump
*.sql.gz

# ------------------------------------------------------------------
# Logs e arquivos temporários
# ------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.pid
*.pid.lock
*.tmp
*.temp
tmp/
temp/

# ------------------------------------------------------------------
# Sistema operacional
# ------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------
# IDEs e editores (configurações pessoais)
# As recomendações de extensões do VS Code são compartilhadas.
# ------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ------------------------------------------------------------------
# Ferramentas locais de IA e MCP (configurações pessoais e credenciais)
# A pasta .claude/ não é ignorada por inteiro: instruções compartilhadas
# podem ser versionadas; apenas as configurações locais ficam fora.
# ------------------------------------------------------------------
.claude/settings.local.json
.claude/*.local.*
CLAUDE.local.md
.mcp.json
.mcp.local.json

# ------------------------------------------------------------------
# Implantação (configuração local das CLIs; nada é publicado na ET01)
# ------------------------------------------------------------------
.vercel/
.render/
