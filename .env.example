# Copie para .env (raiz do repositório) e ajuste. Valores fictícios — nunca versione o .env real.

# --- API (ET01) ---
NODE_ENV=development
# Porta local da API (Seção 13: backend na 3333)
PORT=3333
# Origens autorizadas pelo CORS, separadas por vírgula (frontend local na 5173)
CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Número de proxies confiáveis à frente da API (Render = 1; local = 0)
TRUST_PROXY=0

# --- Banco de dados MySQL 8.4 (Etapa 3) ---
# Servidor local (instalação do MySQL Server, MySQL Workbench ou Docker). Crie o banco com
# database/create_database.sql ou `npm run db:create` e aplique `npm run db:migrate`.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fhdod
# Tamanho do pool de conexões da API
DB_CONNECTION_LIMIT=10
# Na nuvem, use TLS: DB_SSL=true e, se o provedor exigir, o certificado da autoridade (PEM).
DB_SSL=false
DB_SSL_CA=

# Banco dos testes automatizados (recriado a cada `npm test`; somente servidor LOCAL e nunca o
# mesmo DB_NAME). Cada TEST_DB_* vazia usa a DB_* correspondente.
TEST_DB_NAME=fhdod_test
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_USER=
TEST_DB_PASSWORD=

# --- Autenticação própria (Etapa 3; substitui o Supabase Auth) ---
# Segredo de assinatura (HS256) dos tokens de acesso, 32+ caracteres, somente no backend.
# Obrigatório: preencha no .env (a API não inicia com o valor vazio). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do token de acesso (segundos) e da sessão sem renovação (dias)
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=7
# Custo do bcrypt (12 recomendado; mínimo 10 em produção)
BCRYPT_ROUNDS=12

# --- Seed de demonstração (ET02) ---
# Senha das 6 contas @example.com do seed (10+ caracteres, letras e números), gravada só como
# hash bcrypt. Defina uma senha própria (não reutilize senhas reais).
SEED_DEMO_PASSWORD=
# O seed recusa servidor MySQL remoto, salvo SEED_ALLOW_REMOTE=true (decisão do responsável).
SEED_ALLOW_REMOTE=false
# Data de referência (AAAA-MM-DD) para reproduzir exatamente o mesmo conjunto; padrão: hoje.
# SEED_REFERENCE_DATE=2026-11-05

# --- Auditoria (ET03) ---
# HMAC-SHA256 do IP gravado em audit_logs.ip_hash (Seção 10). Opcional localmente (vazio = sem
# ip_hash); obrigatório em produção, com 32+ caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_IP_SECRET=

# --- Pesquisas e pesquisa pública (ET05 e ET06) ---
# Endereço público do frontend: base dos links e do QR Code /p/<slug>?origem=qr|link (E27).
# Padrão local: http://localhost:5173. Em produção é obrigatória e deve usar https://.
PUBLIC_APP_URL=http://localhost:5173
# Segredo HMAC do token de manifestação devolvido por E02 (32+ caracteres). Opcional localmente
# (vazio = segredo aleatório que vale enquanto a API estiver rodando); obrigatório em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANIFESTATION_TOKEN_SECRET=
