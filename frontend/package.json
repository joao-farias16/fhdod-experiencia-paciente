{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Interface web do FHDOD (React 19 + Vite + TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
