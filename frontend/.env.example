# Copie para frontend/.env e ajuste. Somente valores PÚBLICOS: tudo que começa com
# VITE_ é incluído no JavaScript enviado ao navegador. Nunca coloque segredos aqui.

# Base da API. Em desenvolvimento, /api é encaminhado pelo Vite para http://localhost:3333.
VITE_API_BASE_URL=/api/v1
# development | test | production
VITE_APP_ENV=development

# --- Supabase Auth (ET03): login administrativo ---
# URL do projeto e chave PUBLICÁVEL (nunca a chave secreta). Local: API_URL e PUBLISHABLE_KEY de
# `npx supabase status -o env`. Em produção: https://<projeto>.supabase.co.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
