# Copie para backend/.env e ajuste. Valores fictícios — nunca versione o .env real.

# --- API (ET01) ---
NODE_ENV=development
# Porta local da API (Seção 13: backend na 3333)
PORT=3333
# Origens autorizadas pelo CORS, separadas por vírgula (frontend local na 5173)
CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Número de proxies confiáveis à frente da API (Render = 1; local = 0)
TRUST_PROXY=0

# --- Banco de dados (ET02) ---
# Local: PostgreSQL do Supabase CLI (npm run db:start), porta 54322, credenciais padrão do CLI.
# Nuvem (Supabase): DATABASE_URL = pooler em modo transação (porta 6543), usado pela API;
# DIRECT_URL = pooler em modo sessão (porta 5432), usado pelo Prisma Migrate. Exemplo fictício:
#   DATABASE_URL=postgresql://postgres.exemplo:senha-ficticia@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#   DIRECT_URL=postgresql://postgres.exemplo:senha-ficticia@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Banco dos testes de integração (T32). Os testes o criam e migram sozinhos; somente servidor local.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/fhdod_test

# --- Seed de demonstração (ET02) ---
# Senha das 6 contas @example.com criadas no Supabase Auth LOCAL (10+ caracteres, letras e números).
# Defina uma senha própria (não reutilize senhas reais). Obrigatória quando SUPABASE_SECRET_KEY
# estiver preenchida; vazia, o seed não cria contas no Auth.
SEED_DEMO_PASSWORD=
# O seed recusa banco ou Supabase remotos, salvo SEED_ALLOW_REMOTE=true (decisão do responsável).
SEED_ALLOW_REMOTE=false
# Data de referência (AAAA-MM-DD) para reproduzir exatamente o mesmo conjunto; padrão: hoje.
# SEED_REFERENCE_DATE=2026-10-17

# --- Supabase Auth (obrigatórias desde a ET03) ---
# A API valida o token Bearer (auth.getUser) e administra as contas (cadastro, bloqueio e senha
# temporária) com a chave secreta, que existe SOMENTE no backend (nunca no frontend).
# Local: API_URL e SECRET_KEY de `npx supabase status -o env`. Em produção, https://<projeto>.supabase.co.
# O seed também as usa para criar as contas de demonstração.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Somente para `npm run test:supabase` (testes contra o Supabase local): PUBLISHABLE_KEY do status.
SUPABASE_PUBLISHABLE_KEY=

# --- Auditoria (ET03) ---
# HMAC-SHA256 do IP gravado em audit_logs.ip_hash (Seção 10). Opcional localmente (vazio = sem
# ip_hash); obrigatório em produção, com 32+ caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_IP_SECRET=

# --- Pesquisas e pesquisa pública (ET05 e ET06) ---
# Endereço público do frontend: base dos links e do QR Code /p/<slug>?origem=qr|link (E27).
# Padrão local: http://localhost:5173. Em produção é obrigatória e deve usar https://.
PUBLIC_APP_URL=http://localhost:5173
# Segredo HMAC do token de manifestação devolvido por E02 (32+ caracteres). Opcional localmente
# (vazio = segredo aleatório que vale enquanto a API estiver rodando); obrigatório em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANIFESTATION_TOKEN_SECRET=
