# Copie para backend/.env e ajuste. Valores fictícios — nunca versione o .env real.

# --- Utilizadas a partir da ET01 ---
NODE_ENV=development
# Porta local da API (Seção 13: backend na 3333)
PORT=3333
# Origens autorizadas pelo CORS, separadas por vírgula (frontend local na 5173)
CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Número de proxies confiáveis à frente da API (Render = 1; local = 0)
TRUST_PROXY=0

# --- Reservadas para etapas futuras (ainda NÃO lidas pela API) ---
# ET02 — banco de dados (Supabase: pooler transação 6543 e sessão 5432)
# DATABASE_URL=postgresql://postgres.exemplo:senha-ficticia@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.exemplo:senha-ficticia@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# SEED_DEMO_PASSWORD=troque-esta-senha-ficticia
# SEED_ALLOW_REMOTE=false
# ET03 — autenticação (Supabase Auth); a chave secreta existe só no backend
# SUPABASE_URL=https://exemplo.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_exemplo_ficticio
# PUBLIC_APP_URL=http://localhost:5173
# ET06/ET07 — segredos HMAC (gere com: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
# MANIFESTATION_TOKEN_SECRET=
# AUDIT_IP_SECRET=
